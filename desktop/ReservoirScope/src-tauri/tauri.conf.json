{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reservoir Scope Tauri Preview",
  "version": "0.30.0",
  "identifier": "research.reservoir.scope.tauri",
  "build": {
    "beforeDevCommand": "npm run prepare:resources && npm run dev",
    "beforeBuildCommand": "npm run prepare:resources && npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reservoir Scope Tauri Preview",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 600,
        "backgroundColor": "#0b111b",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Offline reservoir research and verified recordings",
    "resources": {
      "resources/": "resources/",
      "../activation_worker/": "activation_worker/",
      "../activation-requirements.lock": "activation-requirements.lock",
      "../activation_setup_bundle/setup-manifest.json": "activation_setup_bundle/setup-manifest.json",
      "../activation_setup_bundle/activation-wheels.lock": "activation_setup_bundle/activation-wheels.lock",
      "../activation_setup_bundle/wheels.json": "activation_setup_bundle/wheels.json",
      "../activation_setup_bundle/model-files.json": "activation_setup_bundle/model-files.json",
      "../activation_setup_bundle/licenses/": "activation_setup_bundle/licenses/",
      "../activation_setup_bundle/assets/uv": "activation_setup_bundle/assets/uv",
      "../activation_setup_bundle/assets/cpython-3.12.13+20260510-aarch64-apple-darwin-install_only.tar.gz": "activation_setup_bundle/assets/cpython-3.12.13+20260510-aarch64-apple-darwin-install_only.tar.gz",
      "../activation_setup/__main__.py": "activation_setup/__main__.py",
      "../activation_setup/__init__.py": "activation_setup/__init__.py",
      "../activation_setup/driver.py": "activation_setup/driver.py"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
