+}
+#[derive(Clone, Debug)]
+struct Active {
+    gesture: StateGesture,
+    intent_id: String,
+    success_offset: u32,
+    pulse_index: usize,
+    last_block: Option<String>,
+}
+impl Active {
+    fn receipt(
+        &self,
+        status: StateActionStatus,
+        now: u64,
+        reason: Option<String>,
+    ) -> StateActionReceipt {
+        StateActionReceipt {
+            schema_version: 1,
+            command_id: self.gesture.command_id.clone(),
+            intent_id: self.intent_id.clone(),
+            identity: self.gesture.identity.clone(),
+            pattern_id: self.gesture.pattern_id.clone(),
+            pattern_sha256: self.gesture.pattern_sha256.clone(),
+            direction: self.gesture.direction.clone(),
+            status,
+            observed_at_unix_ms: now,
+            successful_step_id: None,
+            pulse_index: None,
+            success_offset: None,
+            requested_amount: None,
+            before: None,
+            after: None,
+            delta: None,
+            attenuation: None,
+            actual_l2: None,
+            max_abs_delta: None,
