+            .any(|r| r.command_id == "a" && r.status == StateActionStatus::Expired));
+    }
+
+    #[test]
+    fn model_change_ends_pending_gesture_without_rebinding() {
+        let mut engine = engine();
+        queue(&mut engine, gesture("a"));
+        let mut changed = identity();
+        changed.model_id = "new-model".into();
+        assert!(!engine.prepare(&changed, 1000));
+        assert!(!engine.has_active());
+        assert_eq!(
+            engine.take_receipts().last().unwrap().status,
+            StateActionStatus::IdentityMismatch
+        );
+    }
+}
