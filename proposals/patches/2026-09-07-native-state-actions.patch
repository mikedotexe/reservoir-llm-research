+#[test]
+fn native_signed_owner_to_real_metal_step_to_durable_application() {
+    use crate::esn::{
+        state_action::{
+            direction_sha256, NativeStateCommandV1, StateActionGate, StateActionLimits,
+        },
+        ESN,
+    };
+    let gpu = crate::gpu::Gpu::new().expect("isolated Metal device");
+    let mut engine = ESN::new(
+        16,
+        6,
+        0.25,
+        0.15,
+        0.95,
+        0.35,
+        0.999,
+        &gpu,
+        &mut fastrand::Rng::with_seed(0xAC7105),
+    )
+    .unwrap();
+    let f = fixture();
+    let limits = StateActionLimits::default();
+    let identity = engine
+        .configure_state_actions("signed-native-integration-session".into(), limits.clone())
+        .unwrap();
+    f.bus
+        .publish_native_state_capability(identity.clone(), limits);
+    f.runtime.sweep_native_state();
+    for offset in 0..24 {
+        engine
+            .step_with_state_action_time(&[0.1; 6], NOW - 100 + offset)
+            .unwrap();
+    }
+    let mut values = native_gesture_values("native-integration-gesture");
+    if let Some(NativeStateCommandV1::Gesture { gesture, .. }) =
+        values.native_state_gesture.as_mut()
+    {
+        gesture.identity = identity.clone();
+        gesture.direction = vec![0.0; 16];
+        gesture.direction[3] = 1.0;
+        gesture.pattern_sha256 = direction_sha256(&gesture.direction);
+    }
+    let command = self_command(
+        &f.minime_key,
+        "native-integration-command",
+        "native-integration-nonce",
+        SelfControlFamilyV2::LocalTopology,
+        SelfControlActionV2::Set,
+        SelfControlDurabilityV2::OneShot,
+        1,
+        values,
+        None,
+    );
+    let admission = f.runtime.process(&command, NOW + 1);
+    assert_eq!(admission.status, SelfControlReceiptStatusV2::Accepted);
+    assert_eq!(admission.applied_values.field_count(), 0);
+    assert!(engine.active_state_action_command_id().is_none());
+    f.bus.service_native_state_commands(&mut engine, NOW + 2);
+    engine.set_state_action_gate(StateActionGate {
+        sampled_at_unix_ms: NOW,
+        valid_until_unix_ms: NOW + 3000,
+        allowed: true,
+        reason: None,
+    });
+    engine
+        .step_with_state_action_time(&[0.1; 6], NOW + 3)
+        .unwrap();
+    let engine_receipts = f.bus.collect_native_state_receipts(&mut engine).unwrap();
+    assert!(engine_receipts.iter().any(|r| r["status"] == "completed"));
+    let raw_applied = engine_receipts
+        .iter()
+        .find(|r| r["status"] == "applied")
+        .unwrap();
+    let after: Vec<f32> = serde_json::from_value(raw_applied["after"].clone()).unwrap();
+    assert_eq!(after, engine.x);
+    assert!(raw_applied["actual_l2"].as_f64().unwrap() > 0.0);
+    assert_eq!(
+        raw_applied["successful_step_id"].as_u64(),
+        Some(engine.successful_step_id())
+    );
+    assert_eq!(
+        raw_applied["identity"],
+        serde_json::to_value(identity).unwrap()
+    );
+    let wrapped = f.runtime.sweep_native_state();
+    assert_eq!(wrapped.len(), engine_receipts.len());
+    let status = SelfControlRuntime::verified_status(&f.root).unwrap();
+    assert_eq!(status["integrity_verified"], true);
+    assert_eq!(
+        status["native_state"]["admissions"][0]["status"],
+        "completed"
+    );
+    let applied = status["native_state"]["recent_applications"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|r| r["application"]["status"] == "applied")
+        .unwrap();
+    assert_eq!(applied["command_id"], command.command_id);
+    assert_eq!(applied["intent_id"], command.intent.intent_id);
+    assert_eq!(applied["server_deployment_identity"], DEPLOYMENT);
+    assert_eq!(applied["felt_effect_established"], false);
+    assert_eq!(
+        f.runtime.process(&command, NOW + 4).status,
+        SelfControlReceiptStatusV2::Duplicate
+    );
+    assert!(f.bus.take_native_state_command().is_none());
+    assert!(engine.active_state_action_command_id().is_none());
+    let reopened_bus = SensoryBus::new(32, 4, 7);
+    let reopened = SelfControlRuntime::open_with_safety_probe(
+        f.root.clone(),
+        PROCESS.into(),
+        DEPLOYMENT.into(),
+        reopened_bus.clone(),
+        NOW + 5,
+        || false,
+    )
+    .unwrap();
+    assert!(reopened.is_ready());
+    let recovered = SelfControlRuntime::verified_status(&f.root).unwrap();
+    assert_eq!(
+        recovered["native_state"]["admissions"][0]["status"],
+        "completed"
+    );
+    assert_eq!(
+        recovered["native_state"]["recent_applications"],
+        status["native_state"]["recent_applications"]
+    );
+    assert!(reopened_bus.take_native_state_command().is_none());
