+#[test]
+fn native_generic_json_preserves_measurement_bits_and_state_hash() {
+    // StateActionReceipt and capabilities contain f32 values widened by
+    // serde_json::to_value. The default non-roundtrip JSON parser can change
+    // these f64 Values by one bit, invalidating the durable canonical hash.
+    let mut value = serde_json::to_value(super::RuntimeStateV2::new(DEPLOYMENT.into())).unwrap();
+    value["native_state"] = serde_json::json!({
+        "capability": {"limits": crate::esn::state_action::StateActionLimits::default()},
+        "applications": [{"application": {
+            "status": "applied", "actual_l2": 0.0010000000474974513_f64,
+            "before": vec![0.001_f32, -0.137_f32, 0.14467227458953857_f32],
+            "after": vec![0.002_f32, -0.136_f32, 0.332_f32],
+            "delta": vec![0.001_f32, 0.001_f32, -0.001_f32],
+            "realized_noise": vec![-0.0028778540436178446_f32]
+        }}]
+    });
+    let state: super::RuntimeStateV2 = serde_json::from_value(value).unwrap();
+    let original = serde_json::to_value(&state).unwrap();
+    let envelope = super::RuntimeStateEnvelopeV1 {
+        schema: super::STATE_ENVELOPE_SCHEMA.into(),
+        state_sha256: super::state_sha256(&state).unwrap(),
+        state,
+    };
+    let encoded = serde_json::to_vec_pretty(&envelope).unwrap();
+    let decoded: super::RuntimeStateEnvelopeV1 = serde_json::from_slice(&encoded).unwrap();
+    let observed = serde_json::to_value(&decoded.state).unwrap();
+    assert_eq!(
+        observed, original,
+        "JSON must preserve every measured number"
+    );
+    super::verify_state_envelope_integrity(decoded).unwrap();
+}
