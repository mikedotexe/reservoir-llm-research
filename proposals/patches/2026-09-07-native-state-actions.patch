+//! Session-scoped, explicitly bounded native state gestures. This queue is not
+//! checkpointed: durable authority and crash reconciliation belong to the adapter.
+use anyhow::{ensure, Result};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::collections::{HashMap, VecDeque};
+
+const MAX_COMMANDS: usize = 4096;
+const MAX_RECEIPTS: usize = 1024;
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct NativeStateIdentity {
+    pub engine_session_id: String,
+    pub model_id: String,
+    pub node_layout_id: String,
+    pub node_count: usize,
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct StatePulse {
+    pub success_offset: u32,
+    pub amount: f32,
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct StateGesture {
+    pub command_id: String,
+    pub identity: NativeStateIdentity,
+    pub pattern_id: String,
+    pub pattern_sha256: String,
+    pub direction: Vec<f32>,
+    pub pulses: Vec<StatePulse>,
+    pub expires_at_unix_ms: u64,
+    pub allow_attenuation: bool,
+    pub supersedes: Option<String>,
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]
+#[serde(tag = "operation", rename_all = "snake_case", deny_unknown_fields)]
+pub enum NativeStateCommandV1 {
+    Gesture {
+        schema_version: u32,
+        gesture: StateGesture,
+    },
+    Cancel {
+        schema_version: u32,
+        command_id: String,
+    },
+}
+impl NativeStateCommandV1 {
+    pub fn validate_shape(&self) -> Result<()> {
+        match self {
+            Self::Cancel {
+                schema_version,
+                command_id,
+            } => {
+                ensure!(
+                    *schema_version == 1,
+                    "unsupported native state command version"
+                );
+                valid_id(command_id)?;
+            }
+            Self::Gesture {
+                schema_version,
+                gesture: g,
+            } => {
+                ensure!(
+                    *schema_version == 1,
+                    "unsupported native state command version"
+                );
+                for id in [
+                    &g.command_id,
+                    &g.pattern_id,
+                    &g.identity.engine_session_id,
+                    &g.identity.model_id,
+                    &g.identity.node_layout_id,
+                ] {
+                    valid_id(id)?;
+                }
+                if let Some(id) = &g.supersedes {
+                    valid_id(id)?;
+                }
+                ensure!(
+                    (1..=4096).contains(&g.identity.node_count)
+                        && g.direction.len() == g.identity.node_count,
+                    "direction dimensions differ"
+                );
+                ensure!(
+                    g.direction.iter().all(|v| v.is_finite()),
+                    "nonfinite direction"
+                );
+                let norm = g
+                    .direction
+                    .iter()
+                    .map(|v| f64::from(*v).powi(2))
+                    .sum::<f64>()
+                    .sqrt();
+                ensure!(
+                    (norm - 1.0).abs() <= 1e-5,
+                    "direction must have unit L2 norm"
+                );
+                ensure!(
+                    direction_sha256(&g.direction) == g.pattern_sha256,
+                    "direction hash mismatch"
+                );
+                ensure!(
+                    !g.pulses.is_empty() && g.pulses.len() <= 32,
+                    "gesture pulse count out of bounds"
+                );
+                ensure!(
+                    g.pulses
+                        .iter()
+                        .all(|p| p.amount.is_finite() && p.success_offset < 32),
+                    "invalid pulse"
+                );
+                ensure!(
+                    g.pulses
+                        .windows(2)
+                        .all(|p| p[0].success_offset < p[1].success_offset),
+                    "pulse offsets must increase strictly"
+                );
+            }
+        }
+        Ok(())
+    }
+}
+fn valid_id(id: &str) -> Result<()> {
+    ensure!(
+        !id.trim().is_empty() && id.len() <= 256,
+        "invalid native state identity"
+    );
+    Ok(())
+}
+pub fn direction_sha256(direction: &[f32]) -> String {
+    let mut hash = Sha256::new();
+    hash.update(b"native-state-direction-f32-v1\0");
+    hash.update((direction.len() as u64).to_le_bytes());
+    for value in direction {
+        hash.update(value.to_bits().to_le_bytes());
+    }
+    format!("{:x}", hash.finalize())
+}
+
+/// Engineering pilot envelope, not a claim of live safety or subjective effect.
+/// Caller policy may narrow these limits; the compiled envelope cannot be widened.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct StateActionLimits {
+    pub max_requested_l2: f32,
+    pub max_total_requested_l2: f32,
+    pub max_coordinate_delta: f32,
+    pub max_success_steps: u32,
+    pub max_age_ms: u64,
+}
+impl Default for StateActionLimits {
+    fn default() -> Self {
+        Self {
+            max_requested_l2: 0.001,
+            max_total_requested_l2: 0.032,
+            max_coordinate_delta: 0.001,
+            max_success_steps: 32,
+            max_age_ms: 60_000,
+        }
+    }
+}
+impl StateActionLimits {
+    pub fn validate(&self) -> Result<()> {
+        let cap = Self::default();
+        for (value, max) in [
+            (self.max_requested_l2, cap.max_requested_l2),
+            (self.max_total_requested_l2, cap.max_total_requested_l2),
+            (self.max_coordinate_delta, cap.max_coordinate_delta),
+        ] {
+            ensure!(
+                value.is_finite() && value > 0.0 && value <= max,
+                "invalid or widened state action limit"
+            );
+        }
+        ensure!(
+            self.max_success_steps > 0
+                && self.max_success_steps <= cap.max_success_steps
+                && self.max_age_ms > 0
+                && self.max_age_ms <= cap.max_age_ms,
+            "invalid duration envelope"
+        );
+        Ok(())
+    }
+}
