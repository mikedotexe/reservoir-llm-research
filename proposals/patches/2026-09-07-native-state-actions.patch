+}
+pub(crate) struct StateActionEngine {
+    pub identity: NativeStateIdentity,
+    limits: StateActionLimits,
+    active: Option<Active>,
+    seen: HashMap<String, (StateGesture, String)>,
+    receipts: VecDeque<StateActionReceipt>,
+    gate: Option<StateActionGate>,
+}
+impl StateActionEngine {
+    pub fn new(identity: NativeStateIdentity, limits: StateActionLimits) -> Result<Self> {
+        valid_id(&identity.engine_session_id)?;
+        limits.validate()?;
+        Ok(Self {
+            identity,
+            limits,
+            active: None,
+            seen: HashMap::new(),
+            receipts: VecDeque::new(),
+            gate: None,
+        })
+    }
+    pub fn set_gate(&mut self, gate: StateActionGate) {
+        self.gate = Some(gate);
+    }
+    pub fn take_receipts(&mut self) -> Vec<StateActionReceipt> {
+        self.receipts.drain(..).collect()
+    }
+    pub fn has_active(&self) -> bool {
+        self.active.is_some()
+    }
+    pub fn active_command_id(&self) -> Option<&str> {
+        self.active.as_ref().map(|a| a.gesture.command_id.as_str())
+    }
+    pub fn queue(
+        &mut self,
+        command: NativeStateCommandV1,
+        intent_id: String,
+        now: u64,
+    ) -> Result<QueueOutcome> {
+        command.validate_shape()?;
+        valid_id(&intent_id)?;
+        ensure!(
+            self.receipts.len() + 3 < MAX_RECEIPTS,
+            "native action receipt queue full"
+        );
+        // Admission also observes absolute expiry; an expired gesture cannot
+        // block its successor merely because no native step occurred meanwhile.
+        if self
+            .active
+            .as_ref()
+            .is_some_and(|active| now >= active.gesture.expires_at_unix_ms)
+        {
+            let active = self.active.take().unwrap();
+            self.receipts
+                .push_back(active.receipt(StateActionStatus::Expired, now, None));
+        }
+        match command {
+            NativeStateCommandV1::Cancel { command_id, .. } => {
+                if self.active_command_id() == Some(command_id.as_str()) {
+                    let active = self.active.take().unwrap();
+                    self.receipts.push_back(active.receipt(
+                        StateActionStatus::Cancelled,
+                        now,
+                        Some(format!("cancelled_by_intent:{intent_id}")),
+                    ));
+                    Ok(QueueOutcome {
+                        status: "cancelled".into(),
+                        command_id,
+                        superseded_command_id: None,
+                    })
+                } else {
+                    Ok(QueueOutcome {
+                        status: "not_active".into(),
+                        command_id,
+                        superseded_command_id: None,
+                    })
+                }
+            }
+            NativeStateCommandV1::Gesture { gesture, .. } => {
+                if let Some((existing, existing_intent)) = self.seen.get(&gesture.command_id) {
+                    ensure!(
+                        existing == &gesture
+                            && existing_intent == &intent_id
+                            && existing.pulses.iter().zip(&gesture.pulses).all(
+                                |(left, right)| left.amount.to_bits() == right.amount.to_bits()
+                            ),
+                        "command identity reused with different payload or authority"
+                    );
+                    return Ok(QueueOutcome {
+                        status: "duplicate".into(),
+                        command_id: gesture.command_id,
+                        superseded_command_id: None,
+                    });
+                }
+                ensure!(
+                    self.seen.len() < MAX_COMMANDS,
+                    "session command ledger full"
+                );
+                ensure!(
+                    gesture.identity == self.identity,
+                    "native state identity mismatch"
+                );
+                ensure!(
+                    gesture.expires_at_unix_ms > now
+                        && gesture.expires_at_unix_ms - now <= self.limits.max_age_ms,
+                    "expired or excessive request age"
+                );
+                let total = gesture
+                    .pulses
+                    .iter()
+                    .map(|p| f64::from(p.amount.abs()))
+                    .sum::<f64>();
+                ensure!(
+                    total <= f64::from(self.limits.max_total_requested_l2),
+                    "gesture total displacement budget exceeded"
+                );
+                ensure!(
+                    gesture
+                        .pulses
+                        .iter()
+                        .all(|p| p.amount.abs() <= self.limits.max_requested_l2
+                            && p.success_offset < self.limits.max_success_steps),
+                    "pulse outside operating envelope"
+                );
+                let superseded = self.active_command_id().map(str::to_owned);
+                if let Some(id) = &superseded {
+                    ensure!(
+                        gesture.supersedes.as_ref() == Some(id),
+                        "active gesture requires explicit supersession"
+                    );
+                } else {
+                    ensure!(
+                        gesture.supersedes.is_none(),
+                        "supersession target is not active"
+                    );
+                }
+                if let Some(active) = self.active.take() {
+                    self.receipts.push_back(active.receipt(
+                        StateActionStatus::Superseded,
+                        now,
+                        Some(format!("superseded_by:{}", gesture.command_id)),
+                    ));
+                }
+                self.seen.insert(
+                    gesture.command_id.clone(),
+                    (gesture.clone(), intent_id.clone()),
+                );
+                let active = Active {
+                    gesture,
+                    intent_id,
+                    success_offset: 0,
+                    pulse_index: 0,
+                    last_block: None,
+                };
+                let command_id = active.gesture.command_id.clone();
+                self.receipts
+                    .push_back(active.receipt(StateActionStatus::Accepted, now, None));
+                self.active = Some(active);
+                Ok(QueueOutcome {
+                    status: "accepted".into(),
+                    command_id,
+                    superseded_command_id: superseded,
+                })
+            }
+        }
+    }
+    /// Called before ordinary native mutation. Expiry proceeds even while suspended.
+    pub fn prepare(&mut self, identity: &NativeStateIdentity, now: u64) -> bool {
+        let Some(active) = self.active.as_ref() else {
+            return false;
+        };
+        let terminal = if now >= active.gesture.expires_at_unix_ms {
+            Some(StateActionStatus::Expired)
+        } else if &active.gesture.identity != identity {
+            Some(StateActionStatus::IdentityMismatch)
+        } else {
+            None
+        };
+        if let Some(status) = terminal {
+            if self.receipts.len() < MAX_RECEIPTS {
+                let active = self.active.take().unwrap();
+                self.receipts.push_back(active.receipt(status, now, None));
+            }
+            return false;
+        }
+        if self.receipts.len() + 3 >= MAX_RECEIPTS {
+            return false;
+        }
+        let block = match &self.gate {
+            None => Some("no_current_regulator_gate".to_string()),
+            Some(g)
+                if now < g.sampled_at_unix_ms
+                    || now >= g.valid_until_unix_ms
+                    || g.valid_until_unix_ms.saturating_sub(g.sampled_at_unix_ms) > 5_000 =>
+            {
+                Some("stale_regulator_gate".into())
+            }
+            Some(g) if !g.allowed => Some(
+                g.reason
+                    .clone()
+                    .unwrap_or_else(|| "regulator_preempted".into()),
+            ),
+            _ => None,
+        };
+        let active = self.active.as_mut().unwrap();
+        if let Some(reason) = block {
+            if active.last_block.as_ref() != Some(&reason) {
+                self.receipts.push_back(active.receipt(
+                    StateActionStatus::Suspended,
+                    now,
+                    Some(reason.clone()),
+                ));
+                active.last_block = Some(reason);
+            }
+            return false;
+        }
+        active.last_block = None;
+        true
+    }
+    pub fn failed_step(&mut self, now: u64, reason: String) {
+        if let Some(active) = self.active.as_mut() {
+            if active.last_block.as_ref() != Some(&reason) && self.receipts.len() < MAX_RECEIPTS {
+                self.receipts.push_back(active.receipt(
+                    StateActionStatus::StepFailed,
+                    now,
+                    Some(reason.clone()),
+                ));
+                active.last_block = Some(reason);
+            }
+        }
+    }
+    /// All fallible GPU work must be checked before this infallible state boundary.
+    pub fn apply_success(
+        &mut self,
+        state: &mut [f32],
+        step_id: u64,
+        now: u64,
+        wait_us: u64,
+        leak: f32,
+        noise: &[f32],
+    ) {
+        let Some(active) = self.active.as_mut() else {
+            return;
+        };
+        let pulse = &active.gesture.pulses[active.pulse_index];
+        if pulse.success_offset == active.success_offset {
+            let before = state.to_vec();
+            let mut receipt = active.receipt(StateActionStatus::Applied, now, None);
+            let amount = pulse.amount;
+            let mut beta = 1.0_f64;
+            for (&x, &d) in state.iter().zip(&active.gesture.direction) {
+                let requested = f64::from(amount) * f64::from(d);
+                if requested != 0.0 {
+                    let headroom = if requested > 0.0 {
+                        1.0 - f64::from(x)
+                    } else {
+                        1.0 + f64::from(x)
+                    };
+                    beta = beta
+                        .min(headroom / requested.abs())
+                        .min(f64::from(self.limits.max_coordinate_delta) / requested.abs());
+                }
+            }
+            beta = beta.clamp(0.0, 1.0);
+            if beta < 1.0 && !active.gesture.allow_attenuation {
+                receipt.status = StateActionStatus::HeadroomRejected;
+                receipt.reason = Some("requested_direction_exceeds_headroom".into());
+                beta = 0.0;
+            }
+            let factor = beta as f32;
+            let mut clipped = false;
+            if factor > 0.0 && amount != 0.0 {
+                for (x, &direction) in state.iter_mut().zip(&active.gesture.direction) {
+                    let next = *x + (factor * amount) * direction;
+                    let bounded = next.clamp(-1.0, 1.0);
+                    clipped |= next.to_bits() != bounded.to_bits();
+                    *x = bounded;
+                }
+            }
+            let delta: Vec<f32> = state
+                .iter()
+                .zip(&before)
+                .map(|(after, before)| after - before)
+                .collect();
+            let actual_l2 = delta
+                .iter()
+                .map(|d| f64::from(*d).powi(2))
+                .sum::<f64>()
+                .sqrt();
+            if actual_l2 == 0.0 && receipt.status == StateActionStatus::Applied {
+                receipt.status = StateActionStatus::NoOp;
+                receipt.reason = Some(
+                    if amount == 0.0 {
+                        "zero_amount"
+                    } else {
+                        "zero_headroom_or_float32_resolution"
+                    }
+                    .into(),
+                );
+            }
+            receipt.successful_step_id = Some(step_id);
+            receipt.pulse_index = Some(active.pulse_index);
+            receipt.success_offset = Some(active.success_offset);
+            receipt.requested_amount = Some(amount);
+            receipt.max_abs_delta = Some(delta.iter().fold(0.0_f32, |a, b| a.max(b.abs())));
+            receipt.actual_l2 = Some(actual_l2);
+            receipt.before = Some(before);
+            receipt.after = Some(state.to_vec());
+            receipt.delta = Some(delta);
+            receipt.attenuation = Some(factor);
+            receipt.clipped = clipped;
+            receipt.boundary_wait_us = Some(wait_us);
+            receipt.effective_leak = Some(leak);
+            receipt.realized_noise = Some(noise.to_vec());
+            self.receipts.push_back(receipt);
+            active.pulse_index += 1;
+        }
+        active.success_offset += 1;
+        if active.pulse_index == active.gesture.pulses.len() {
+            let active = self.active.take().unwrap();
+            let mut receipt = active.receipt(StateActionStatus::Completed, now, None);
+            receipt.successful_step_id = Some(step_id);
+            self.receipts.push_back(receipt);
+        }
+    }
+}
