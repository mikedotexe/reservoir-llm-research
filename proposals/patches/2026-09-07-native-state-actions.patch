diff --git a/minime/src/self_control_runtime/native_state.rs b/minime/src/self_control_runtime/native_state.rs
new file mode 100644
index 0000000..59de62c
--- /dev/null
+++ b/minime/src/self_control_runtime/native_state.rs
@@ -0,0 +1,244 @@
+//! Durable native-action admission. Numerical checkpoints never replay this queue.
+use super::*;
+use crate::{esn::state_action::NativeStateCommandV1, sensory_bus::NativeStateEnvelope};
+use serde_json::{json, Value};
+
+const MAX_NATIVE_ADMISSIONS: usize = 4096;
+const MAX_NATIVE_APPLICATIONS: usize = 256;
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+struct Admission {
+    command: SelfControlCommandV2,
+    status: String,
+}
+
+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+pub(super) struct NativeAdapterState {
+    #[serde(default)]
+    admissions: BTreeMap<String, Admission>,
+    #[serde(default)]
+    gesture_ids: BTreeMap<String, String>,
+    #[serde(default)]
+    applications: Vec<Value>,
+    #[serde(default)]
+    capability: Option<Value>,
+}
+impl NativeAdapterState {
+    pub(super) fn is_empty(&self) -> bool {
+        self.admissions.is_empty()
+            && self.gesture_ids.is_empty()
+            && self.applications.is_empty()
+            && self.capability.is_none()
+    }
+    pub(super) fn status(&self) -> Value {
+        json!({"schema": "minime.native_state.status.v1", "target_being": "minime",
+            "capability": self.capability,
+            "admissions": self.admissions.iter().map(|(id, a)| json!({"intent_id": id,
+                "command_id": a.command.command_id, "status": a.status,
+                "requested_values": a.command.intent.values})).collect::<Vec<_>>(),
+            "recent_applications": self.applications, "felt_effect_established": false})
+    }
+    fn push_application(&mut self, value: Value) {
+        self.applications.push(value);
+        if self.applications.len() > MAX_NATIVE_APPLICATIONS {
+            self.applications
+                .drain(..self.applications.len() - MAX_NATIVE_APPLICATIONS);
+        }
+    }
+}
+
+impl SelfControlRuntime {
+    pub fn native_state_ready(&self) -> bool {
+        self.is_ready() && self.bus.native_state_admission_ready()
+    }
+
+    pub(super) fn apply_native_state(
+        &self,
+        inner: &mut RuntimeInner,
+        command: &SelfControlCommandV2,
+        command_sha256: &str,
+        family: &str,
+        now: u64,
+    ) -> SelfControlReceiptV2 {
+        let native = command.intent.values.native_state_gesture.as_ref().unwrap();
+        let reject = if command.intent.authority_class != SelfControlAuthorityClassV2::SelfOwned
+            || command.intent.actor.being != TARGET_BEING
+        {
+            Some("native_state_requires_minime_owner")
+        } else if command.intent.family != SelfControlFamilyV2::LocalTopology
+            || command.intent.durability != SelfControlDurabilityV2::OneShot
+            || command.intent.values.field_count() != 1
+        {
+            Some("native_state_requires_sole_one_shot")
+        } else if !self.bus.native_state_admission_ready() {
+            Some("native_state_adapter_unavailable")
+        } else if inner
+            .state
+            .native_state
+            .admissions
+            .contains_key(&command.intent.intent_id)
+        {
+            Some("native_state_intent_id_already_admitted")
+        } else if inner.state.native_state.admissions.len() >= MAX_NATIVE_ADMISSIONS {
+            Some("native_state_durable_ledger_full")
+        } else {
+            None
+        };
+        if let Some(reason) = reject {
+            let receipt =
+                self.rejected(command, current_revision(&inner.state, family), now, reason);
+            return self.cache_authenticated(inner, command, command_sha256, receipt, now);
+        }
+        let gesture_key = match native {
+            // The durable owner ledger never reuses gesture IDs, including
+            // across engine sessions. A delayed signed cancellation therefore
+            // cannot accidentally target a different gesture with an old ID.
+            NativeStateCommandV1::Gesture { gesture, .. } => Some(gesture.command_id.clone()),
+            NativeStateCommandV1::Cancel { .. } => None,
+        };
+        if gesture_key
+            .as_ref()
+            .is_some_and(|id| inner.state.native_state.gesture_ids.contains_key(id))
+        {
+            let receipt = self.rejected(
+                command,
+                current_revision(&inner.state, family),
+                now,
+                "native_state_command_id_already_admitted",
+            );
+            return self.cache_authenticated(inner, command, command_sha256, receipt, now);
+        }
+        // Persist the accepted intent BEFORE any engine-visible queue insertion.
+        // If this process dies after commit, recovery says application_unknown;
+        // it never retries a possibly applied state displacement.
+        let intent_id = command.intent.intent_id.clone();
+        inner.state.native_state.admissions.insert(
+            intent_id.clone(),
+            Admission {
+                command: command.clone(),
+                status: "accepted".into(),
+            },
+        );
+        if let Some(key) = gesture_key {
+            inner
+                .state
+                .native_state
+                .gesture_ids
+                .insert(key, intent_id.clone());
+        }
+        inner
+            .state
+            .revision_by_family
+            .insert(family.into(), command.intent.revision);
+        let receipt = self.receipt(
+            command,
+            SelfControlReceiptStatusV2::Accepted,
+            command.intent.revision,
+            now,
+            command.intent.values.clone(),
+            SelfControlValuesV2::default(),
+            ControlSnapshot::default(),
+            Some("native_state_durably_accepted_not_applied".into()),
+            None,
+        );
+        let receipt = self.cache_authenticated(inner, command, command_sha256, receipt, now);
+        if receipt.status != SelfControlReceiptStatusV2::Accepted {
+            return receipt;
+        }
+        if let Err(reason) = self.bus.queue_native_state_command(NativeStateEnvelope {
+            command: native.clone(),
+            authenticated_intent_id: intent_id.clone(),
+            command_expires_at_unix_ms: command.intent.command_expires_at_unix_ms,
+        }) {
+            self.bus
+                .record_native_state_receipt(json!({"schema_version":1, "intent_id":intent_id,
+                "status":"rejected", "observed_at_unix_ms":now, "reason":reason}));
+        }
+        receipt
+    }
+
+    pub(super) fn recover_native_state(&self, inner: &mut RuntimeInner, now: u64) {
+        // Clearing capability prevents a stopped/changed engine being advertised
+        // by the offline status file until the new engine configures its identity.
+        inner.state.native_state.capability = None;
+        let unresolved: Vec<_> = inner
+            .state
+            .native_state
+            .admissions
+            .iter()
+            .filter(|(_, a)| !terminal(&a.status))
+            .map(|(id, a)| (id.clone(), a.command.clone()))
+            .collect();
+        for (id, command) in unresolved {
+            inner
+                .state
+                .native_state
+                .admissions
+                .get_mut(&id)
+                .unwrap()
+                .status = "application_unknown".into();
+            inner.state.native_state.push_application(self.native_application(&command,
+                json!({"schema_version":1,"intent_id":id,"status":"application_unknown",
+                    "observed_at_unix_ms":now,"reason":"process_restart_does_not_replay_native_actions"})));
+        }
+    }
+
+    /// Called by the existing receipt sweeper; returns only durably recorded
+    /// application evidence for broadcast. Failed commits retain their inputs.
+    pub fn sweep_native_state(&self) -> Vec<Value> {
+        let applications = self.bus.take_native_state_receipts();
+        let capability = self.bus.native_state_status();
+        let mut inner = self.inner.lock();
+        if self.disabled_reason.is_some() || inner.integrity_blocked.is_some() {
+            self.bus.restore_native_state_receipts(applications);
+            return Vec::new();
+        }
+        if applications.is_empty() && inner.state.native_state.capability == capability {
+            return Vec::new();
+        }
+        let previous = inner.state.native_state.clone();
+        inner.state.native_state.capability = capability;
+        let mut result = Vec::new();
+        for application in &applications {
+            let Some(intent_id) = application.get("intent_id").and_then(Value::as_str) else {
+                continue;
+            };
+            let Some(admission) = inner.state.native_state.admissions.get_mut(intent_id) else {
+                continue;
+            };
+            if let Some(status) = application.get("status").and_then(Value::as_str) {
+                admission.status = status.to_string();
+            }
+            let wrapped = self.native_application(&admission.command, application.clone());
+            inner.state.native_state.push_application(wrapped.clone());
+            result.push(wrapped);
+        }
+        if self.persist(&inner.state).is_err() {
+            inner.state.native_state = previous;
+            self.bus.restore_native_state_receipts(applications);
+            return Vec::new();
+        }
+        result
+    }
+
+    fn native_application(&self, command: &SelfControlCommandV2, application: Value) -> Value {
+        json!({"schema":"minime.native_state.application.v1", "command_id":command.command_id,
+            "intent_id":command.intent.intent_id, "target_being":TARGET_BEING,
+            "server_process_identity":self.process_identity,
+            "server_deployment_identity":self.deployment_identity,
+            "application":application,"felt_effect_established":false})
+    }
+}
+fn terminal(status: &str) -> bool {
+    matches!(
+        status,
+        "completed"
+            | "cancelled"
+            | "superseded"
+            | "expired"
+            | "identity_mismatch"
+            | "rejected"
+            | "not_active"
+            | "application_unknown"
+    )
+}
