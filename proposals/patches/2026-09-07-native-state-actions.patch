new file mode 100644
index 0000000..0ce836a
--- /dev/null
+++ b/minime_autonomy/native_state.py
@@ -0,0 +1,220 @@
+"""Native substrate actions: exact f32 patterns over authenticated owner transport.
+
+STATE_NUDGE and STATE_GESTURE are direct native-state operations. The historical
+NATIVE_GESTURE and PERTURB actions retain their separate sensory semantics.
+No function in this module writes anonymous control messages or handles keys.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import struct
+import time
+import uuid
+from typing import Any, Mapping
+
+NATIVE_STATE_ACTIONS = {"STATE_NUDGE", "STATE_GESTURE", "STATE_CANCEL", "STATE_STATUS"}
+IDENTITY_FIELDS = {"engine_session_id", "model_id", "node_layout_id", "node_count"}
+GESTURE_FIELDS = {"command_id", "identity", "pattern_id", "pattern_sha256", "direction", "pulses", "expires_at_unix_ms", "allow_attenuation", "supersedes"}
+TERMINAL = {"completed", "cancelled", "not_active", "superseded", "expired", "identity_mismatch", "rejected", "application_unknown"}
+
+
+def _id(value: Any) -> str:
+    if not isinstance(value, str) or not value.strip() or len(value.encode()) > 256:
+        raise ValueError("native state identifiers require 1–256 UTF-8 bytes")
+    return value
+
+
+def _integer(value: Any, low: int, high: int) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or not low <= value <= high:
+        raise ValueError(f"native state integer must be within [{low}, {high}]")
+    return value
+
+
+def _f32(value: Any) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
+        raise ValueError("native state values must be finite numbers")
+    try:
+        result = struct.unpack("<f", struct.pack("<f", value))[0]
+    except (OverflowError, struct.error) as error:
+        raise ValueError("native state number is outside float32") from error
+    if not math.isfinite(result):
+        raise ValueError("native state number is outside float32")
+    return result
+
+
+def direction_sha256(direction: list[float]) -> str:
+    payload = b"native-state-direction-f32-v1\0" + struct.pack("<Q", len(direction))
+    return hashlib.sha256(payload + b"".join(struct.pack("<f", value) for value in direction)).hexdigest()
+
+
+def validate_native_state_command(command: Mapping[str, Any]) -> dict[str, Any]:
+    if not isinstance(command, Mapping):
+        raise ValueError("native state command requires an object")
+    value = dict(command)
+    operation = value.get("operation")
+    expected = {"operation", "schema_version", "gesture" if operation == "gesture" else "command_id"}
+    if set(value) != expected or type(value.get("schema_version")) is not int or value["schema_version"] != 1:
+        raise ValueError("native state command fields/version do not match v1")
+    if operation == "cancel":
+        _id(value["command_id"])
+        return value
+    if operation != "gesture" or not isinstance(value["gesture"], Mapping):
+        raise ValueError("native state operation must be gesture or cancel")
+    gesture = dict(value["gesture"])
+    if set(gesture) != GESTURE_FIELDS:
+        raise ValueError("native state gesture fields do not match v1")
+    identity = gesture["identity"]
+    if not isinstance(identity, Mapping) or set(identity) != IDENTITY_FIELDS:
+        raise ValueError("native state identity fields do not match v1")
+    for field in IDENTITY_FIELDS - {"node_count"}:
+        _id(identity[field])
+    count = _integer(identity["node_count"], 1, 4096)
+    _id(gesture["command_id"])
+    _id(gesture["pattern_id"])
+    if gesture["supersedes"] is not None:
+        _id(gesture["supersedes"])
+    if not isinstance(gesture["allow_attenuation"], bool):
+        raise ValueError("allow_attenuation requires an explicit boolean")
+    _integer(gesture["expires_at_unix_ms"], 1, 2**64 - 1)
+    raw_direction = gesture["direction"]
+    if not isinstance(raw_direction, list) or len(raw_direction) != count:
+        raise ValueError("direction length must match native node_count")
+    direction = [_f32(x) for x in raw_direction]
+    if abs(math.sqrt(sum(x*x for x in direction)) - 1.0) > 1e-5:
+        raise ValueError("direction must have unit L2 norm")
+    if gesture["pattern_sha256"] != direction_sha256(direction):
+        raise ValueError("native direction hash mismatch")
+    pulses = gesture["pulses"]
+    if not isinstance(pulses, list) or not 1 <= len(pulses) <= 32:
+        raise ValueError("native gesture requires 1–32 pulses")
+    clean_pulses = []
+    last_offset = -1
+    for pulse in pulses:
+        if not isinstance(pulse, Mapping) or set(pulse) != {"success_offset", "amount"}:
+            raise ValueError("pulse requires exactly success_offset and amount")
+        offset = _integer(pulse["success_offset"], 0, 31)
+        if offset <= last_offset:
+            raise ValueError("pulse success offsets must increase strictly")
+        amount = _f32(pulse["amount"])
+        if abs(amount) > _f32(0.001):
+            raise ValueError("native pulse exceeds the 0.001 L2 pilot envelope")
+        clean_pulses.append({"success_offset": offset, "amount": amount})
+        last_offset = offset
+    if sum(abs(p["amount"]) for p in clean_pulses) > _f32(0.032):
+        raise ValueError("native schedule exceeds total L2 pilot envelope")
+    gesture.update(direction=direction, pulses=clean_pulses, identity=dict(identity))
+    return {"operation": "gesture", "schema_version": 1, "gesture": gesture}
+
+
+def prepare_native_action(base: str, raw_arg: str, status: Mapping[str, Any], *, now_ms: int) -> dict[str, Any]:
+    """Bind one authored request to the observed native session before signing.
+
+    A nodes map supplies relative signed weights, normalized to a unit direction;
+    amount is the L2 displacement. An explicit direction must already be unit.
+    Explicit identities and hashes are verified, never silently substituted.
+    """
+    if base == "STATE_CANCEL":
+        return validate_native_state_command({"operation":"cancel", "schema_version":1, "command_id":raw_arg.strip()})
+    if base not in {"STATE_NUDGE", "STATE_GESTURE"}:
+        raise ValueError("unknown native state action")
+    native = status.get("native_state") or {}
+    capability = native.get("capability") or {}
+    identity = capability.get("identity")
+    if status.get("target_being") != "minime" or capability.get("target_being") != "minime" or not isinstance(identity, Mapping):
+        raise ValueError("native Minime capability is unavailable; peer native apply is unsupported")
+    def unique_object(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise ValueError("duplicate native action field: " + key)
+            result[key] = value
+        return result
+    request = json.loads(raw_arg, object_pairs_hook=unique_object)
+    if not isinstance(request, dict):
+        raise ValueError("STATE_NUDGE/STATE_GESTURE requires a JSON object")
+    allowed = {"command_id", "identity", "pattern_id", "pattern_sha256", "direction", "nodes", "amount", "pulses", "expires_at_unix_ms", "allow_attenuation", "supersedes"}
+    if set(request) - allowed:
+        raise ValueError("unknown native action fields: " + ", ".join(sorted(set(request)-allowed)))
+    if "identity" in request:
+        authored_identity = request["identity"]
+        if (not isinstance(authored_identity, dict) or set(authored_identity) != IDENTITY_FIELDS
+                or type(authored_identity.get("node_count")) is not int or authored_identity != identity):
+            raise ValueError("authored native identity differs from the current capability")
+    if ("nodes" in request) == ("direction" in request):
+        raise ValueError("choose exactly one nodes map or unit direction")
+    if "nodes" in request:
+        nodes = request["nodes"]
+        if not isinstance(nodes, dict) or not nodes:
+            raise ValueError("nodes must be a nonempty map of exact node indices to signed weights")
+        direction = [0.0] * _integer(identity["node_count"], 1, 4096)
+        for key, weight in nodes.items():
+            if not isinstance(key, str) or not key.isascii() or not key.isdigit() or str(int(key)) != key:
+                raise ValueError("nodes require canonical integer index keys")
+            index = _integer(int(key), 0, len(direction)-1)
+            direction[index] = _f32(weight)
+        norm = math.sqrt(sum(x*x for x in direction))
+        if norm == 0:
+            raise ValueError("native direction has zero norm")
+        direction = [_f32(x/norm) for x in direction]
+    else:
+        direction = [_f32(x) for x in request["direction"]]
+    if base == "STATE_NUDGE":
+        if "pulses" in request or "amount" not in request:
+            raise ValueError("STATE_NUDGE requires amount and creates exactly one pulse")
+        pulses = [{"success_offset":0,"amount":request["amount"]}]
+    else:
+        if "amount" in request or "pulses" not in request:
+            raise ValueError("STATE_GESTURE requires a finite pulses schedule")
+        pulses = request["pulses"]
+    advertised_age = _integer((capability.get("limits") or {}).get("max_age_ms", 60_000), 1, 60_000)
+    expiry = request.get("expires_at_unix_ms", now_ms + min(30_000, advertised_age))
+    if isinstance(expiry, bool) or not isinstance(expiry, int) or not now_ms < expiry <= now_ms + 60_000:
+        raise ValueError("native action expiry must be in the next 60 seconds")
+    gesture = {"command_id":request.get("command_id", "native-state:" + uuid.uuid4().hex),
+        "identity":dict(identity), "pattern_id":request.get("pattern_id", "owner-node-pattern"),
+        "pattern_sha256":request.get("pattern_sha256", direction_sha256(direction)), "direction":direction,
+        "pulses":pulses,"expires_at_unix_ms":expiry,"allow_attenuation":request.get("allow_attenuation", False),
+        "supersedes":request.get("supersedes")}
+    command = validate_native_state_command({"operation":"gesture","schema_version":1,"gesture":gesture})
+    limits = capability.get("limits") or {}
+    # The engine may narrow its compiled pilot envelope. Preflight that exact
+    # advertised envelope before signing; never scale an owner's pulse silently.
+    pulse_limit = _f32(limits.get("max_requested_l2", 0.001))
+    total_limit = _f32(limits.get("max_total_requested_l2", 0.032))
+    step_limit = _integer(limits.get("max_success_steps", 32), 1, 32)
+    age_limit = _integer(limits.get("max_age_ms", 60_000), 1, 60_000)
+    clean_pulses = command["gesture"]["pulses"]
+    if pulse_limit <= 0 or total_limit <= 0 or any(abs(p["amount"]) > pulse_limit or p["success_offset"] >= step_limit for p in clean_pulses):
+        raise ValueError("native request exceeds the current advertised pulse envelope")
+    if sum(abs(p["amount"]) for p in clean_pulses) > total_limit or expiry - now_ms > age_limit:
+        raise ValueError("native request exceeds the current advertised total/duration envelope")
+    return command
+
+
+def execute_native_action(base: str, raw_arg: str, client: Any, *, now=time.time, sleep=time.sleep, wait_seconds: float = 5.0, wait_clock=time.monotonic) -> dict[str, Any]:
+    status = client.status()
+    if base == "STATE_STATUS":
+        return {"schema":"minime.native_state.action_result.v1", "native_state":status.get("native_state"), "felt_effect_established":False}
+    command = prepare_native_action(base, raw_arg, status, now_ms=int(now()*1000))
+    delivery = client.issue({"native_state_gesture":command}, durability="one-shot", retry_revision_conflict=False,
+        evidence_refs=("minime-action:" + base.lower(),), success_conditions=("actual native application receipt",),
+        stop_conditions=("signed cancellation", "absolute expiry", "regulator preemption"))
+    wanted = set(delivery["intent_ids"])
+    deadline = wait_clock() + wait_seconds
+    native = status.get("native_state") or {}
+    while wait_clock() < deadline:
+        native = client.status().get("native_state") or {}
+        matching = [a for a in native.get("admissions", []) if a.get("intent_id") in wanted]
+        if matching and all(a.get("status") in TERMINAL for a in matching):
+            break
+        sleep(0.05)
+    receipts = [r for r in native.get("recent_applications", []) if r.get("intent_id") in wanted]
+    applied = [r for r in receipts if (r.get("application") or {}).get("status") == "applied"
+        and (r["application"].get("actual_l2") or 0) > 0]
+    return {"schema":"minime.native_state.action_result.v1", "delivery":delivery, "native_command":command,
+        "applications":receipts, "observed_nonzero_applications":len(applied),
+        "admission_statuses":[a for a in native.get("admissions", []) if a.get("intent_id") in wanted],
+        "completion_semantics":"completed means schedule exhausted; individual applied receipts establish displacement",
+        "felt_effect_established":False}
