+        esn.step_with_state_action_time(&[0.1; 6], 1000).unwrap();
+        let receipt = esn
+            .take_state_action_receipts()
+            .into_iter()
+            .find(|r| r.status == StateActionStatus::Applied)
+            .unwrap();
+        assert_eq!(receipt.realized_noise.as_ref().unwrap().len(), 16);
+        assert_eq!(receipt.after.as_ref().unwrap(), &esn.x);
+        let radius = (esn.x.iter().map(|v| v * v).sum::<f32>() / 16.0).sqrt();
+        assert_eq!(esn.get_geom_radius().to_bits(), radius.to_bits());
+        assert_eq!(receipt.effective_leak, Some(esn.last_step_trace.leak));
+        assert!(esn.sr.pending_rank1.is_empty());
+        assert_eq!(receipt.successful_step_id, Some(1));
+    }
+    #[test]
+    fn failed_native_boundary_preserves_state_rng_override_and_gesture() {
+        let gpu = Gpu::new().unwrap();
+        let mut esn = make(&gpu);
+        configure(&mut esn, 0.001);
+        esn.set_leak_override(0.42, 3, "leak-test".into());
+        let before = esn.x.clone();
+        let rng = esn.rng.get_seed();
+        esn.sr.completion_failure = Some("injected completion failure".into());
+        assert!(esn.step_with_state_action_time(&[0.1; 6], 1000).is_err());
+        assert_eq!(esn.x, before);
+        assert_eq!(esn.rng.get_seed(), rng);
+        assert_eq!(esn.leak_override_status().unwrap().remaining_ticks, 3);
+        assert_eq!(esn.successful_step_id(), 0);
+        assert_eq!(
+            esn.active_state_action_command_id(),
+            Some("native-test-command")
+        );
+        assert!(esn.snapshot_v2().is_err());
+        assert!(esn.get_covariance().is_err());
+        assert!(!esn
+            .take_state_action_receipts()
+            .iter()
+            .any(|r| r.status == StateActionStatus::Applied));
+        // Absolute expiry still terminates an action while the estimator is failed.
+        assert!(esn.step_with_state_action_time(&[0.1; 6], 2000).is_err());
+        assert_eq!(esn.active_state_action_command_id(), None);
+        assert!(esn
+            .take_state_action_receipts()
+            .iter()
+            .any(|r| r.status == StateActionStatus::Expired));
+    }
+    #[test]
+    fn zero_native_action_preserves_exact_ordinary_equations_and_checkpoint_values() {
+        let gpu = Gpu::new().unwrap();
+        let mut ordinary = make(&gpu);
+        let snapshot = ordinary.snapshot_v2().unwrap();
+        let mut zero = ESN::from_snapshot_v2(&snapshot, &gpu).unwrap();
+        configure(&mut zero, -0.0);
+        ordinary
+            .step_with_state_action_time(&[0.1; 6], 1000)
+            .unwrap();
+        zero.step_with_state_action_time(&[0.1; 6], 1000).unwrap();
+        let a = ordinary.snapshot_v2().unwrap();
+        let b = zero.snapshot_v2().unwrap();
+        assert_eq!(a.state, b.state);
+        assert_eq!(a.geom_radius.to_bits(), b.geom_radius.to_bits());
+        assert_eq!(a.geom_baseline.to_bits(), b.geom_baseline.to_bits());
+        assert_eq!(a.rng_state, b.rng_state);
+        assert_eq!(a.leak_live.to_bits(), b.leak_live.to_bits());
+        assert_eq!(a.spectral.covariance, b.spectral.covariance);
+        assert_eq!(a.spectral.tick, b.spectral.tick);
+        assert!(zero
+            .take_state_action_receipts()
+            .iter()
+            .any(|r| r.status == StateActionStatus::NoOp));
+    }
+    #[test]
+    fn numerical_restore_never_resumes_or_reauthorizes_a_pending_action() {
+        let gpu = Gpu::new().unwrap();
+        let mut esn = make(&gpu);
+        configure(&mut esn, 0.001);
+        let snapshot = esn.snapshot_v2().unwrap();
+        let restored = ESN::from_snapshot_v2(&snapshot, &gpu).unwrap();
+        assert!(restored.state_action_identity().is_none());
+        assert!(restored.active_state_action_command_id().is_none());
+        assert_eq!(restored.x, esn.x);
+    }
+}
