+from unittest.mock import patch
+
+from minime_autonomy.native_state import prepare_native_action, validate_native_state_command, execute_native_action
+from minime_autonomy.self_control_v2 import MinimeSelfControlV2Client, SelfControlV2Error, validate_exact_self_control_values
+from tests.test_self_control_v2 import _result
+
+IDENTITY = {"engine_session_id":"session-test","model_id":"model-test","node_layout_id":"layout-test","node_count":4}
+STATUS = {"target_being":"minime","native_state":{"capability":{"target_being":"minime","identity":IDENTITY}}}
+
+class NativeStateActionTests(unittest.TestCase):
+    def command(self):
+        return prepare_native_action("STATE_NUDGE", json.dumps({"nodes":{"0":1,"2":-1},"amount":0.001,"command_id":"chosen"}), STATUS, now_ms=1000)
+
+    def test_authored_weights_prepare_one_exact_hashed_f32_pulse(self):
+        command = self.command()
+        gesture = command["gesture"]
+        self.assertEqual(gesture["identity"], IDENTITY)
+        self.assertEqual(gesture["direction"][0], -gesture["direction"][2])
+        self.assertEqual(gesture["direction"][1], 0)
+        self.assertEqual(gesture["pulses"], [{"success_offset":0,"amount":struct.unpack("<f", struct.pack("<f", 0.001))[0]}])
+        self.assertEqual(validate_native_state_command(command), command)
+        self.assertEqual(validate_exact_self_control_values({"native_state_gesture":command}), {"native_state_gesture":command})
+
+    def test_rejects_stale_explicit_identity_peer_and_bad_node_coordinates(self):
+        bad = copy.deepcopy(IDENTITY); bad["engine_session_id"] = "previous-session"
+        for request in [{"nodes":{"0":1},"amount":0.001,"identity":bad},
+                        {"nodes":{"4":1},"amount":0.001}, {"nodes":{"00":1},"amount":0.001},
+                        {"nodes":{"0":0},"amount":0.001}, {"nodes":{"0":1},"amount":0.01},
+                        {"nodes":{"0":1},"amount":True}, {"nodes":{"0":1},"amount":0.001,"target_being":"astrid"}]:
+            with self.subTest(request=request), self.assertRaises(ValueError):
+                prepare_native_action("STATE_NUDGE", json.dumps(request), STATUS, now_ms=1000)
+        peer = copy.deepcopy(STATUS); peer["target_being"] = "astrid"
+        with self.assertRaises(ValueError):
+            prepare_native_action("STATE_NUDGE", '{"nodes":{"0":1},"amount":0.001}', peer, now_ms=1000)
+
+    def test_exact_decoder_rejects_unknown_nonfinite_hash_mixed_and_schedule_errors(self):
+        for version in [True, 1.0, "1", 2]:
+            command = self.command(); command["schema_version"] = version
+            with self.subTest(version=version), self.assertRaises(ValueError):
+                validate_native_state_command(command)
+        for mutation in [lambda g:g.update(unrecognized=True), lambda g:g.update(pattern_sha256="0"*64),
+                         lambda g:g.update(direction=[float('nan'),0,0,0]), lambda g:g.update(allow_attenuation="yes"),
+                         lambda g:g.update(pulses=[{"success_offset":1,"amount":0.001},{"success_offset":1,"amount":0.001}])]:
+            command = self.command(); mutation(command["gesture"])
+            with self.assertRaises(ValueError): validate_native_state_command(command)
+        with self.assertRaises(SelfControlV2Error):
+            validate_exact_self_control_values({"native_state_gesture":self.command(),"fill_target":0.68})
+
+    def test_signed_admission_does_not_require_or_assert_applied_values(self):
+        calls = []
+        def runner(args, **kwargs):
+            calls.append(args)
+            values = json.loads(args[args.index("--values-json")+1])
+            result = _result("local-topology", values, status="accepted")
+            result["attempts"][0]["self_control_receipt"]["applied_values"] = {}
+            return subprocess.CompletedProcess(args, 0, json.dumps(result), "")
+        client = MinimeSelfControlV2Client(binary="/tmp/inert-minime-test", runner=runner)
+        delivery = client.issue({"native_state_gesture":self.command()}, durability="one-shot")
+        self.assertEqual(delivery["receipts"][0]["status"], "accepted")
+        self.assertEqual(delivery["receipts"][0]["applied_values"], {})
+        self.assertEqual(len(calls), 1)
+
+    def test_false_native_application_in_admission_is_rejected(self):
+        def runner(args, **kwargs):
+            values = json.loads(args[args.index("--values-json")+1])
+            return subprocess.CompletedProcess(args, 0, json.dumps(_result("local-topology", values, status="accepted")), "")
+        client = MinimeSelfControlV2Client(binary="/tmp/inert-minime-test", runner=runner)
+        with self.assertRaises(SelfControlV2Error): client.issue({"native_state_gesture":self.command()}, durability="one-shot")
+
+    def test_single_action_preflights_and_distinguishes_zero_effect_completion(self):
+        class Client:
+            calls = 0
+            def status(self):
+                self.calls += 1
+                status = copy.deepcopy(STATUS)
+                if self.calls > 1:
+                    status["native_state"].update(admissions=[{"intent_id":"intent-test","status":"completed"}],
+                        recent_applications=[{"intent_id":"intent-test","application":{"status":"no_op","actual_l2":0}},
+                            {"intent_id":"intent-test","application":{"status":"completed"}}])
+                return status
+            def issue(self, values, **kwargs):
+                self.values = values; self.options = kwargs
+                return {"intent_ids":["intent-test"]}
+        client = Client()
+        result = execute_native_action("STATE_NUDGE", '{"nodes":{"0":1},"amount":0}', client, now=lambda:1.0, sleep=lambda _:None)
+        self.assertEqual(client.calls, 2)
+        self.assertEqual(client.options["retry_revision_conflict"], False)
+        self.assertEqual(result["observed_nonzero_applications"], 0)
+        self.assertEqual(result["admission_statuses"][0]["status"], "completed")
+        self.assertFalse(result["felt_effect_established"])
+
+    def test_native_next_actions_are_preserved_without_legacy_aliasing(self):
+        from minime_autonomy.parsing import parse_next_action
+        for action in ['STATE_NUDGE {"nodes":{"0":1},"amount":0.001}', 'STATE_GESTURE {"nodes":{"0":1},"pulses":[{"success_offset":0,"amount":0.001}]}', 'STATE_CANCEL chosen', 'STATE_STATUS']:
+            result = parse_next_action('I choose this.\nNEXT: ' + action)
+            self.assertEqual(result[0], action)
+
+if __name__ == '__main__': unittest.main()
