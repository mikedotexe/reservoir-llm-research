@@ -0,0 +1,333 @@
+//! Finite native numerical rehearsal. No runtime, sockets, journals, or model calls.
+//! Ordinary/result vectors are two sides of the same action boundary, not futures.
+use anyhow::{ensure, Context, Result};
+use clap::Parser;
+use minime::esn::state_action::{
+    direction_sha256, NativeStateCommandV1, NativeStateIdentity, StateActionGate,
+    StateActionLimits, StateActionReceipt, StateActionStatus, StateGesture, StatePulse,
+};
+use minime::esn::{EsnSnapshotV2, EsnStepTraceV1, ESN};
+use minime::gpu::Gpu;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    fs,
+    path::{Path, PathBuf},
+    time::Instant,
+};
+
+#[derive(Parser)]
+struct Args {
+    #[arg(long)]
+    baseline: PathBuf,
+    #[arg(long)]
+    output: PathBuf,
+}
+
+fn input(t: usize) -> Vec<f32> {
+    (0..66)
+        .map(|i| 0.15_f32 * (((t * 7 + i * 3) as f32) * 0.071_f32).sin())
+        .collect()
+}
+fn save(path: &Path, data: &impl serde::Serialize) -> Result<()> {
+    fs::write(path, serde_json::to_vec_pretty(data)?)?;
+    Ok(())
+}
+fn numeric_snapshot(snapshot: &EsnSnapshotV2) -> Result<Value> {
+    let mut value = serde_json::to_value(snapshot)?;
+    value["spectral"]
+        .as_object_mut()
+        .context("spectral object")?
+        .remove("last_profile");
+    Ok(value)
+}
+fn equal_bits(a: &[f32], b: &[f32]) -> bool {
+    a.len() == b.len() && a.iter().zip(b).all(|(a, b)| a.to_bits() == b.to_bits())
+}
+fn pattern() -> Vec<f32> {
+    let mut direction: Vec<f32> = (0..128).map(|i| ((i as f32) * 0.47_f32).cos()).collect();
+    let norm = direction
+        .iter()
+        .map(|v| f64::from(*v).powi(2))
+        .sum::<f64>()
+        .sqrt() as f32;
+    for v in &mut direction {
+        *v /= norm;
+    }
+    direction
+}
+fn command(
+    identity: NativeStateIdentity,
+    name: &str,
+    scenario: &str,
+    now: u64,
+) -> NativeStateCommandV1 {
+    let direction = pattern();
+    let offsets: Vec<u32> = match scenario {
+        "finite" | "cancel" => (0..8).collect(),
+        "sparse" => vec![0, 3, 7],
+        _ => vec![0],
+    };
+    let pulses = offsets
+        .iter()
+        .enumerate()
+        .map(|(i, offset)| StatePulse {
+            success_offset: *offset,
+            amount: if scenario == "zero" {
+                0.0
+            } else if i % 2 == 0 {
+                0.001
+            } else {
+                -0.001
+            },
+        })
+        .collect();
+    NativeStateCommandV1::Gesture {
+        schema_version: 1,
+        gesture: StateGesture {
+            command_id: name.into(),
+            identity,
+            pattern_id: "cosine-index-0.47-unit-f32-v1".into(),
+            pattern_sha256: direction_sha256(&direction),
+            direction,
+            pulses,
+            expires_at_unix_ms: now + if scenario == "expired" { 1 } else { 60_000 },
+            allow_attenuation: false,
+            supersedes: None,
+        },
+    }
+}
+fn verify_receipt(receipt: &StateActionReceipt, state: &[f32], radius: f32) -> Result<()> {
+    if matches!(
+        receipt.status,
+        StateActionStatus::Applied | StateActionStatus::NoOp
+    ) {
+        let before = receipt.before.as_ref().context("ordinary state")?;
+        let after = receipt.after.as_ref().context("applied result")?;
+        let delta = receipt.delta.as_ref().context("delta")?;
+        ensure!(
+            equal_bits(after, state),
+            "receipt differs from actual native state"
+        );
+        ensure!(
+            before.len() == 128 && after.len() == 128 && delta.len() == 128,
+            "wrong state dimensions"
+        );
+        for ((before, after), delta) in before.iter().zip(after).zip(delta) {
+            ensure!(
+                (after - before).to_bits() == delta.to_bits(),
+                "delta is not exact Float32 difference"
+            );
+        }
+        ensure!(
+            receipt
+                .realized_noise
+                .as_ref()
+                .is_some_and(|noise| noise.len() == 128),
+            "action noise unavailable"
+        );
+        let rms = (state.iter().map(|v| v * v).sum::<f32>() / 128.0).sqrt();
+        ensure!(
+            radius.to_bits() == rms.to_bits(),
+            "geometry does not describe resulting native state"
+        );
+    }
+    Ok(())
+}
+
+fn main() -> Result<()> {
+    let args = Args::parse();
+    ensure!(!args.output.exists(), "output must be a new directory");
+    let source_identity =
+        option_env!("STATE_ACTION_SOURCE_SHA256").context("build with recorded source identity")?;
+    ensure!(
+        source_identity.len() == 64,
+        "invalid recorded source identity"
+    );
+    let baseline_bytes = fs::read(&args.baseline)?;
+    let baseline: Value = serde_json::from_slice(&baseline_bytes)?;
+    ensure!(
+        baseline["schema"] == "research.native_state_action_baseline.v1",
+        "unexpected baseline"
+    );
+    let cases = baseline["cases"].as_array().context("reference cases")?;
+    ensure!(cases.len() == 6, "expected six fixed reference cases");
+    fs::create_dir_all(&args.output)?;
+    let gpu = Gpu::new()?;
+    let mut ordinary_results = Vec::new();
+    for case in cases {
+        let snapshot: EsnSnapshotV2 = serde_json::from_value(case["checkpoint"].clone())?;
+        let mut native = ESN::from_snapshot_v2(&snapshot, &gpu)?;
+        let inputs: Vec<Vec<f32>> = serde_json::from_value(case["inputs"].clone())?;
+        let rhos: Vec<f32> = serde_json::from_value(case["rhos"].clone())?;
+        let expected: Vec<Vec<f32>> = serde_json::from_value(case["path"].clone())?;
+        let mut path = vec![native.x.clone()];
+        let mut traces = Vec::new();
+        ensure!(
+            inputs.len() == 100 && rhos.len() == 100 && expected.len() == 101,
+            "invalid reference dimensions"
+        );
+        for (i, (input, rho)) in inputs.iter().zip(&rhos).enumerate() {
+            native.set_rho_direct(*rho);
+            native.step(input)?;
+            ensure!(
+                equal_bits(&native.x, &expected[i + 1]),
+                "ordinary state changed at step {}",
+                i + 1
+            );
+            path.push(native.x.clone());
+            traces.push(native.last_step_trace().clone());
+        }
+        let final_snapshot = native.snapshot_v2()?;
+        let reference_final: EsnSnapshotV2 =
+            serde_json::from_value(case["final_snapshot"].clone())?;
+        ensure!(
+            numeric_snapshot(&final_snapshot)? == numeric_snapshot(&reference_final)?,
+            "ordinary numerical checkpoint changed"
+        );
+        let expected_traces: Vec<EsnStepTraceV1> = serde_json::from_value(case["traces"].clone())?;
+        ensure!(
+            traces.len() == expected_traces.len()
+                && traces
+                    .iter()
+                    .zip(&expected_traces)
+                    .all(|(a, b)| a.leak.to_bits() == b.leak.to_bits()
+                        && equal_bits(&a.noise, &b.noise)),
+            "ordinary realized control trace changed"
+        );
+        ordinary_results.push(
+            json!({"start":case["start"],"alternating_rho":case["alternating_rho"],
+            "passed":true,"path":path,"traces":traces,"final_snapshot":final_snapshot}),
+        );
+    }
+    save(
+        &args.output.join("ordinary-results.json"),
+        &ordinary_results,
+    )?;
+    let executable_hash = format!("{:x}", Sha256::digest(fs::read(std::env::current_exe()?)?));
+    let mut results = Vec::new();
+    let mut chosen_receipts = None;
+    let now = 1_788_830_000_000_u64;
+    for case in cases.iter().filter(|v| v["alternating_rho"] == false) {
+        let start = case["start"].as_u64().context("start")? as usize;
+        let snapshot: EsnSnapshotV2 = serde_json::from_value(case["checkpoint"].clone())?;
+        for scenario in [
+            "one_shot",
+            "finite",
+            "sparse",
+            "cancel",
+            "expired",
+            "suspended",
+            "zero",
+        ] {
+            let name = format!("native-{start}-{scenario}");
+            let mut native = ESN::from_snapshot_v2(&snapshot, &gpu)?;
+            let identity = native.configure_state_actions(
+                format!("isolated-{name}"),
+                StateActionLimits::default(),
+            )?;
+            let gesture = command(identity.clone(), &name, scenario, now);
+            native.queue_state_command(gesture.clone(), format!("intent-{name}"), now)?;
+            let duplicate = native.queue_state_command(gesture, format!("intent-{name}"), now)?;
+            let mut receipts = native.take_state_action_receipts();
+            let mut frames = Vec::new();
+            let mut restored_after_action: Option<ESN> = None;
+            let mut continuation_verified = false;
+            for offset in 0..20 {
+                let time = now + 10 + (offset as u64) * 10;
+                if scenario == "cancel" && offset == 2 {
+                    native.queue_state_command(
+                        NativeStateCommandV1::Cancel {
+                            schema_version: 1,
+                            command_id: name.clone(),
+                        },
+                        format!("cancel-{name}"),
+                        time,
+                    )?;
+                    receipts.extend(native.take_state_action_receipts());
+                }
+                native.set_state_action_gate(StateActionGate {
+                    sampled_at_unix_ms: time,
+                    valid_until_unix_ms: time + 5,
+                    allowed: scenario != "suspended" || offset >= 2,
+                    reason: Some("declared_rehearsal_gate".into()),
+                });
+                let tick_input = input(start + offset);
+                let elapsed = Instant::now();
+                native.step_with_state_action_time(&tick_input, time)?;
+                let step_us = elapsed.elapsed().as_micros() as u64;
+                if let Some(restored) = restored_after_action.as_mut() {
+                    restored.step(&tick_input)?;
+                    ensure!(
+                        equal_bits(&native.x, &restored.x),
+                        "later dynamics did not continue from the actual applied state"
+                    );
+                    continuation_verified = true;
+                }
+                let new_receipts = native.take_state_action_receipts();
+                for receipt in &new_receipts {
+                    verify_receipt(receipt, &native.x, native.get_geom_radius())?;
+                }
+                frames.push(json!({"successful_step_id":native.successful_step_id(),"input":tick_input,"state":native.x,
+                    "geom_radius":native.get_geom_radius(),"trace":native.last_step_trace(),"elapsed_us":step_us}));
+                if scenario == "one_shot" && offset == 0 {
+                    restored_after_action =
+                        Some(ESN::from_snapshot_v2(&native.snapshot_v2()?, &gpu)?);
+                }
+                receipts.extend(new_receipts);
+            }
+            let applied = receipts
+                .iter()
+                .filter(|r| r.status == StateActionStatus::Applied)
+                .count();
+            let wanted = match scenario {
+                "finite" => 8,
+                "sparse" => 3,
+                "cancel" => 2,
+                "expired" | "zero" => 0,
+                _ => 1,
+            };
+            ensure!(
+                applied == wanted,
+                "wrong application count for {name}: {applied} != {wanted}"
+            );
+            ensure!(
+                native.active_state_action_command_id().is_none(),
+                "gesture did not terminate: {name}"
+            );
+            if scenario == "one_shot" {
+                ensure!(continuation_verified, "missing continuation proof");
+            }
+            let final_snapshot = native.snapshot_v2()?;
+            let record = json!({"scenario":scenario,"start":start,"identity":identity,"duplicate":duplicate,
+                "passed":true,"applications":applied,"later_continuation_verified":continuation_verified,
+                "receipts":receipts,"frames":frames,"final_snapshot":final_snapshot});
+            save(&args.output.join(format!("{name}.json")), &record)?;
+            if scenario == "finite" && start == 96 {
+                chosen_receipts = Some(record["receipts"].clone());
+            }
+            results.push(json!({"scenario":scenario,"start":start,"passed":true,"applications":applied,"path":format!("{name}.json")}));
+        }
+    }
+    let source_hashes = json!({"implementation_sources":source_identity,"executable":executable_hash,
+        "reference_fixture":format!("{:x}",Sha256::digest(&baseline_bytes))});
+    save(
+        &args.output.join("native-action-response.json"),
+        &json!({
+            "schema":"research.native_action_response.v1","subject":"Minime native ESN rehearsal",
+            "scope":"isolated research copy; no running being","source_hashes":source_hashes,
+            "fill":null,"reference_basis":null,
+            "clock":"successful native step ids; supplied rehearsal clock is not measured wall time",
+            "receipts":chosen_receipts.context("selected finite receipt example")?
+        }),
+    )?;
+    save(
+        &args.output.join("summary.json"),
+        &json!({"schema":"research.native_state_actions.results.v1",
+        "source_hashes":source_hashes,"ordinary_cases":ordinary_results.len(),"ordinary_passed":true,
+        "action_cases":results,"default_operation":"async","action_boundaries":"explicit checked GPU completion",
+        "scope":"finite native experiment; no live being or surrounding controller replay"}),
+    )?;
+    println!("Six ordinary continuations and 21 native action cases passed; actual eight-pulse example exported.");
+    Ok(())
+}
